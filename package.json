{
  "name": "ficharedonda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ficha Redonda: ficha técnica, CMV e preços da pizzaria",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
